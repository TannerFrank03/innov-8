{
  "name": "innov8-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted planning app for Innov-8: boards with Table, Kanban, Timeline and Calendar views.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server server/index.js",
    "dev:client": "vite",
    "build": "tsc -p client && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "backup": "node server/backup.js",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.js",
    "restore": "node server/restore.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
