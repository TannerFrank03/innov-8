# Turso database (required on Vercel; leave unset to use the local file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Port the app listens on
PORT=3000
# Folder that holds planner.db (back this folder up)
DATA_DIR=./data
# Where `npm run backup` writes copies, and how many to keep
BACKUP_DIR=./backups
BACKUP_KEEP=30
# Set to 1 behind an HTTPS reverse proxy so session cookies are marked Secure
TRUST_PROXY=
